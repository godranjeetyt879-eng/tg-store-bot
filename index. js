// Admin state management
let adminState = {};

bot.on('text', async (ctx) => {
  const state = adminState[ctx.from.id];
  if (!state) return;
  
  if (state.step === 'type') {
    state.type = ctx.message.text.toLowerCase();
    state.step = 'country';
    await ctx.reply('Enter country (e.g., India):');
  }
  else if (state.step === 'country') {
    state.country = ctx.message.text;
    state.step = 'year';
    await ctx.reply('Enter year (e.g., 2024):');
  }
  else if (state.step === 'year') {
    state.year = parseInt(ctx.message.text);
    state.step = 'phone';
    await ctx.reply('Enter phone number:');
  }
  else if (state.step === 'phone') {
    state.phone = ctx.message.text;
    state.step = 'password';
    await ctx.reply('Enter password (or "none"):');
  }
  else if (state.step === 'password') {
    state.password = ctx.message.text === 'none' ? null : ctx.message.text;
    state.step = 'twofa';
    await ctx.reply('Enter 2FA (or "none"):');
  }
  else if (state.step === 'twofa') {
    state.twofa = ctx.message.text === 'none' ? null : ctx.message.text;
    state.step = 'price';
    await ctx.reply('Enter price (INR):');
  }
  else if (state.step === 'price') {
    state.price = parseInt(ctx.message.text);
    await addProduct(state);
    await ctx.reply(`✅ Account added!\nID: ${state.id || 'new'}\nType: ${state.type}\nPrice: ₹${state.price}`);
    delete adminState[ctx.from.id];
  }
  else if (state.step === 'delete_product') {
    const productId = parseInt(ctx.message.text);
    const deleted = await deleteProduct(productId);
    if (deleted) await ctx.reply(`✅ Product ${productId} deleted.`);
    else await ctx.reply(`❌ Product ${productId} not found or already sold.`);
    delete adminState[ctx.from.id];
  }
  else if (state.step === 'change_balance_user') {
    state.userId = parseInt(ctx.message.text);
    state.step = 'change_balance_amount';
    await ctx.reply(`User ID: ${state.userId}\nEnter amount (positive to add, negative to deduct):`);
  }
  else if (state.step === 'change_balance_amount') {
    const amount = parseInt(ctx.message.text);
    await updateBalance(state.userId, amount, 'admin', `Admin ${amount > 0 ? 'added' : 'deducted'} ₹${Math.abs(amount)}`);
    await ctx.reply(`✅ ${amount > 0 ? 'Added' : 'Deducted'} ₹${Math.abs(amount)} to/from user ${state.userId}`);
    delete adminState[ctx.from.id];
  }
  else if (state.step === 'ban_user') {
    const userId = parseInt(ctx.message.text);
    await banUser(userId);
    await ctx.reply(`✅ User ${userId} has been banned.`);
    delete adminState[ctx.from.id];
  }
  else if (state.step === 'user_info') {
    const userId = parseInt(ctx.message.text);
    db.get('SELECT * FROM users WHERE id = ?', [userId], (err, user) => {
      if (err || !user) return ctx.reply('User not found.');
      ctx.reply(`👤 *User Info*\n\nID: ${user.id}\nName: ${user.first_name}\nBalance: ₹${user.balance}\nBanned: ${user.is_banned ? 'Yes' : 'No'}\nCreated: ${user.created_at}`, { parse_mode: 'Markdown' });
    });
    delete adminState[ctx.from.id];
  }
  else if (state.step === 'broadcast') {
    const message = ctx.message.text;
    const users = await getAllUsers();
    let sent = 0;
    for (const user of users) {
      try {
        await ctx.telegram.sendMessage(user.id, message, { parse_mode: 'Markdown' });
        sent++;
      } catch(e) {}
    }
    await ctx.reply(`✅ Broadcast sent to ${sent}/${users.length} users.`);
    delete adminState[ctx.from.id];
  }
  else if (state.step === 'ref_percent') {
    const percent = ctx.message.text;
    await setSetting('ref_percent', percent);
    await ctx.reply(`✅ Referral percentage set to ${percent}%`);
    delete adminState[ctx.from.id];
  }
  else if (state.step === 'support_url') {
    const url = ctx.message.text;
    await setSetting('support_url', url);
    await ctx.reply(`✅ Support URL set to ${url}`);
    delete adminState[ctx.from.id];
  }
  else if (state.step === 'usdt_rate') {
    const rate = ctx.message.text;
    await setSetting('usdt_rate', rate);
    await ctx.reply(`✅ USDT rate set to ₹${rate}`);
    delete adminState[ctx.from.id];
  }
  else if (state.step === 'discount') {
    const discount = ctx.message.text;
    await setSetting('discount', discount);
    await ctx.reply(`✅ Discount set to ${discount}%`);
    delete adminState[ctx.from.id];
  }
});


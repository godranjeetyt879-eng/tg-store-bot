// ============ HELPER FUNCTIONS ============
function generateReferralCode(userId) {
  return `REF_${userId}_${Date.now().toString(36)}`;
}

function generateApiKey() {
  return 'FRESHTG_' + crypto.randomBytes(16).toString('hex');
}

function generateApiSecret() {
  return crypto.randomBytes(32).toString('hex');
}

function getOrCreateUser(user, referralCode = null) {
  return new Promise((resolve, reject) => {
    db.get('SELECT * FROM users WHERE id = ?', [user.id], async (err, existingUser) => {
      if (err) return reject(err);
      
      if (existingUser) {
        resolve(existingUser);
      } else {
        const refCode = generateReferralCode(user.id);
        
        db.run(
          'INSERT INTO users (id, username, first_name, referral_code, referred_by) VALUES (?, ?, ?, ?, ?)',
          [user.id, user.username || '', user.first_name || '', refCode, null],
          async function(err) {
            if (err) return reject(err);
            
            if (referralCode) {
              db.get('SELECT id FROM users WHERE referral_code = ?', [referralCode], (err, referrer) => {
                if (err || !referrer) return;
                db.run('UPDATE users SET referred_by = ? WHERE id = ?', [referrer.id, user.id]);
              });
            }
            
            db.get('SELECT * FROM users WHERE id = ?', [user.id], (err, newUser) => {
              if (err) reject(err);
              else resolve(newUser);
            });
          }
        );
      }
    });
  });
}

function getUserBalance(userId) {
  return new Promise((resolve, reject) => {
    db.get('SELECT balance FROM users WHERE id = ?', [userId], (err, row) => {
      if (err) reject(err);
      else resolve(row ? row.balance : 0);
    });
  });
}

function updateBalance(userId, amount, type, description) {
  return new Promise((resolve, reject) => {
    db.run('UPDATE users SET balance = balance + ? WHERE id = ?', [amount, userId], function(err) {
      if (err) return reject(err);
      
      db.run(
        'INSERT INTO transactions (user_id, amount, type, description, status) VALUES (?, ?, ?, ?, ?)',
        [userId, amount, type, description, 'completed'],
        (err) => {
          if (err) reject(err);
          else resolve(true);
        }
      );
    });
  });
}

function getAvailableProduct(type, country = null, year = null) {
  return new Promise((resolve, reject) => {
    let query = 'SELECT * FROM products WHERE status = "available" AND type = ?';
    let params = [type];
    
    if (country) {
      query += ' AND country = ?';
      params.push(country);
    }
    if (year) {
      query += ' AND year = ?';
      params.push(year);
    }
    
    query += ' ORDER BY created_at ASC LIMIT 1';
    
    db.get(query, params, (err, product) => {
      if (err) reject(err);
      else resolve(product);
    });
  });
}

function getStockCount(type, country = null) {
  return new Promise((resolve, reject) => {
    let query = 'SELECT COUNT(*) as count FROM products WHERE status = "available" AND type = ?';
    let params = [type];
    
    if (country) {
      query += ' AND country = ?';
      params.push(country);
    }
    
    db.get(query, params, (err, row) => {
      if (err) reject(err);
      else resolve(row ? row.count : 0);
    });
  });
}

function purchaseProduct(userId, type, country = null, year = null) {
  return new Promise((resolve, reject) => {
    db.serialize(() => {
      db.run('BEGIN TRANSACTION');
      
      getAvailableProduct(type, country, year).then(product => {
        if (!product) {
          db.run('ROLLBACK');
          return reject(new Error('No product available'));
        }
        
        db.get('SELECT balance FROM users WHERE id = ?', [userId], (err, user) => {
          if (err || !user || user.balance < product.price) {
            db.run('ROLLBACK');
            return reject(new Error('Insufficient balance'));
          }
          
          db.run('UPDATE products SET status = "sold" WHERE id = ?', [product.id], (err) => {
            if (err) {
              db.run('ROLLBACK');
              return reject(err);
            }
            
            db.run('UPDATE users SET balance = balance - ? WHERE id = ?', [product.price, userId], (err) => {
              if (err) {
                db.run('ROLLBACK');
                return reject(err);
              }
              
              db.run(
                'INSERT INTO orders (user_id, product_id, amount, status) VALUES (?, ?, ?, ?)',
                [userId, product.id, product.price, 'completed'],
                (err) => {
                  if (err) {
                    db.run('ROLLBACK');
                    return reject(err);
                  }
                  
                  db.run(
                    'INSERT INTO transactions (user_id, amount, type, description, status) VALUES (?, ?, ?, ?, ?)',
                    [userId, -product.price, 'purchase', `Purchased ${type} account`, 'completed'],
                    (err) => {
                      if (err) {
                        db.run('ROLLBACK');
                        return reject(err);
                      }
                      
                      db.run('COMMIT');
                      resolve(product);
                    }
                  );
                }
              );
            });
          });
        });
      }).catch(err => {
        db.run('ROLLBACK');
        reject(err);
      });
    });
  });
}

function getReferralStats(userId) {
  return new Promise((resolve, reject) => {
    db.get(
      `SELECT 
        COUNT(DISTINCT r.referred_user_id) as total_referrals,
        COALESCE(SUM(r.amount), 0) as total_earnings
       FROM referral_earnings r 
       WHERE r.referrer_id = ?`,
      [userId],
      (err, row) => {
        if (err) reject(err);
        else resolve(row || { total_referrals: 0, total_earnings: 0 });
      }
    );
  });
}

function getUserStats(userId) {
  return new Promise((resolve, reject) => {
    db.get(
      `SELECT 
        COUNT(DISTINCT o.id) as total_orders,
        COALESCE(SUM(o.amount), 0) as total_spent
       FROM orders o
       WHERE o.user_id = ? AND o.status = 'completed'`,
      [userId],
      (err, row) => {
        if (err) reject(err);
        else resolve(row || { total_orders: 0, total_spent: 0 });
      }
    );
  });
}

function getApiKey(userId) {
  return new Promise((resolve, reject) => {
    db.get('SELECT api_key, secret, created_at, last_regenerated FROM api_keys WHERE user_id = ?', [userId], (err, row) => {
      if (err) reject(err);
      else resolve(row);
    });
  });
}

function createApiKey(userId) {
  return new Promise((resolve, reject) => {
    const apiKey = generateApiKey();
    const secret = generateApiSecret();
    
    db.run(
      'INSERT INTO api_keys (user_id, api_key, secret, last_regenerated) VALUES (?, ?, ?, ?)',
      [userId, apiKey, secret, new Date().toISOString()],
      function(err) {
        if (err) reject(err);
        else resolve({ api_key: apiKey, secret: secret });
      }
    );
  });
}

function regenerateApiKey(userId) {
  return new Promise((resolve, reject) => {
    const apiKey = generateApiKey();
    const secret = generateApiSecret();
    
    db.run(
      'UPDATE api_keys SET api_key = ?, secret = ?, last_regenerated = ? WHERE user_id = ?',
      [apiKey, secret, new Date().toISOString(), userId],
      function(err) {
        if (err) reject(err);
        else resolve({ api_key: apiKey, secret: secret });
      }
    );
  });
}

function logApiRequest(userId, endpoint, ip) {
  db.run(
    'INSERT INTO api_logs (user_id, endpoint, ip) VALUES (?, ?, ?)',
    [userId, endpoint, ip]
  );
}


bot.command('approve_deposit', async (ctx) => {
  if (!ADMIN_IDS.includes(ctx.from.id)) return;
  const args = ctx.message.text.split(' ');
  if (args.length < 3) return ctx.reply('Usage: /approve_deposit <user_id> <amount>');
  const userId = parseInt(args[1]);
  const amount = parseInt(args[2]);
  await updateBalance(userId, amount, 'deposit', `Deposit of ₹${amount}`);
  db.run('UPDATE deposits SET status = "approved", amount = ? WHERE user_id = ? AND status = "pending"', [amount, userId]);
  await ctx.reply(`✅ Approved ₹${amount} deposit for user ${userId}`);
  await ctx.telegram.sendMessage(userId, `✅ Your deposit of ₹${amount} has been approved and added to your wallet!`);
});

// ============ EXPRESS API SERVER ============
const app = express();
app.use(express.json());

function authenticateApiKey(req, res, next) {
  const { api_key } = req.body;
  if (!api_key) return res.status(401).json({ success: false, error: 'API key required' });
  db.get('SELECT user_id FROM api_keys WHERE api_key = ?', [api_key], (err, key) => {
    if (err || !key) return res.status(401).json({ success: false, error: 'Invalid API key' });
    req.userId = key.user_id;
    next();
  });
}

app.post('/api/v1/get_balance', authenticateApiKey, async (req, res) => {
  const balance = await getUserBalance(req.userId);
  res.json({ success: true, balance, balance_usdt: (balance / 94).toFixed(2), currency: 'INR' });
});

app.post('/api/v1/get_stock', authenticateApiKey, async (req, res) => {
  const { country } = req.body;
  const count = await getStockCount('account', country);
  res.json({ success: true, stock: count, country: country || 'all' });
});

app.post('/api/v1/buy_account', authenticateApiKey, async (req, res) => {
  const { country } = req.body;
  if (!country) return res.status(400).json({ success: false, error: 'Country required' });
  try {
    const product = await purchaseProduct(req.userId, 'account', country);
    res.json({ success: true, order_id: product.id, account: { phone: product.phone, country: product.country, price_paid: product.price } });
  } catch (error) {
    res.status(400).json({ success: false, error: error.message });
  }
});

app.post('/api/v1/get_otp', authenticateApiKey, async (req, res) => {
  const { phone } = req.body;
  if (!phone) return res.status(400).json({ success: false, error: 'Phone required' });
  res.json({ success: true, phone, otp: Math.floor(100000 + Math.random() * 900000).toString(), twofa: 'No 2FA' });
});

app.get('/health', (req, res) => res.json({ status: 'ok' }));


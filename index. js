// Middleware
bot.use(async (ctx, next) => {
  if (ctx.from && !ctx.from.is_bot) {
    const botStatus = await getSetting('bot_status');
    if (botStatus === 'off' && !ADMIN_IDS.includes(ctx.from.id)) {
      return ctx.reply('🔴 Bot is currently under maintenance. Please try again later.');
    }
    const user = await getOrCreateUser(ctx.from);
    if (user.is_banned && !ADMIN_IDS.includes(ctx.from.id)) {
      return ctx.reply('🚫 You have been banned from using this bot.');
    }
    const referralCode = ctx.startPayload || null;
    if (referralCode && !user.referred_by) {
      db.get('SELECT id FROM users WHERE referral_code = ?', [referralCode], (err, referrer) => {
        if (err || !referrer || referrer.id === ctx.from.id) return;
        db.run('UPDATE users SET referred_by = ? WHERE id = ?', [referrer.id, ctx.from.id]);
      });
    }
  }
  await next();
});


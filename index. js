function getFlagEmoji(country) {
  const flags = {
    'India': '🇮🇳',
    'USA': '🇺🇸',
    'UK': '🇬🇧',
    'Canada': '🇨🇦',
    'Australia': '🇦🇺'
  };
  return flags[country] || '🌍';
}


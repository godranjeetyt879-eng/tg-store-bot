bot.on('text', async (ctx) => {
  const state = adminState[ctx.from.id];
  if (!state) return;
  
  if (state.step === 'country') {
    state.country = ctx.message.text;
    state.step = 'year';
    await ctx.reply('Step 3: Enter year (e.g., 2024):');
  } 
  else if (state.step === 'year') {
    state.year = parseInt(ctx.message.text);
    state.step = 'phone';
    await ctx.reply('Step 4: Enter phone number:');
  }
  else if (state.step === 'phone') {
    state.phone = ctx.message.text;
    state.step = 'password';
    await ctx.reply('Step 5: Enter password (or "none"):');
  }
  else if (state.step === 'password') {
    state.password = ctx.message.text === 'none' ? null : ctx.message.text;
    state.step = 'twofa';
    await ctx.reply('Step 6: Enter 2FA code (or "none"):');
  }
  else if (state.step === 'twofa') {
    state.twofa = ctx.message.text === 'none' ? null : ctx.message.text;
    state.step = 'price';
    await ctx.reply('Step 7: Enter price in INR:');
  }
  else if (state.step === 'price') {
    state.price = parseInt(ctx.message.text);
    
    db.run(
      `INSERT INTO products (type, country, year, phone, password, twofa, price) 
       VALUES (?, ?, ?, ?, ?, ?, ?)`,
      [state.type, state.country, state.year, state.phone, state.password, state.twofa, state.price],
      function(err) {
        if (err) {
          ctx.reply('❌ Error adding product!');
        } else {
          ctx.reply(`✅ Product added successfully!\n\nID: ${this.lastID}\nType: ${state.type}\nPrice: ₹${state.price}`);
        }
        delete adminState[ctx.from.id];
      }
    );
  }
  else if (state.step === 'add_balance_user') {
    const userId = parseInt(ctx.message.text);
    state.userId = userId;
    state.step = 'add_balance_amount';
    await ctx.reply(`User ID: ${userId}\nEnter amount to add (in INR):`);
  }
  else if (state.step === 'add_balance_amount') {
    const amount = parseInt(ctx.message.text);
    await updateBalance(state.userId, amount, 'admin_add', `Admin added ₹${amount}`);
    await ctx.reply(`✅ Added ₹${amount} to user ${state.userId}`);
    delete adminState[ctx.from.id];
  }
});

